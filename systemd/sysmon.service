[Unit]
Description=sysmon - Linux health monitoring agent
Documentation=file:///opt/sysmon/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sysmon/bin/sysmon.py --config /etc/sysmon/sysmon.conf daemon
# `systemctl reload sysmon` -> SIGHUP -> config re-read without restarting
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Never let the monitor itself become the problem
Nice=10
MemoryMax=128M
CPUQuota=20%

# Sandboxing (the agent needs root only to restart services and clean /tmp)
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/log/sysmon /var/lib/sysmon /tmp /var/tmp

StateDirectory=sysmon
LogsDirectory=sysmon
SyslogIdentifier=sysmon

[Install]
WantedBy=multi-user.target
